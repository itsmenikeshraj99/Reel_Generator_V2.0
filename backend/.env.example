# Supabase (DB + Auth + Storage)
# Get from Supabase Dashboard -> Settings -> API
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SERVICE_ROLE_KEY"           # service_role key — backend only, never expose to frontend
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"          # for verifying user tokens

# Storage
STORAGE_BUCKET="reels-videos"

# Gemini AI
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# App
MAX_VIDEO_SIZE_MB=500
FRONTEND_ORIGIN="http://localhost:3000"

# Worker (where to send processing jobs)
WORKER_URL="http://127.0.0.1:8001/process"
WORKER_SHARED_SECRET="GENERATE_A_LONG_RANDOM_STRING"  # shared with worker
