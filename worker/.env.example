# Supabase (DB + Storage)
# Use the SERVICE_ROLE key — the worker has its own auth (X-Worker-Secret) and needs full DB access
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"
STORAGE_BUCKET="reels-videos"

# Gemini AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Worker security
WORKER_SHARED_SECRET="GENERATE_A_LONG_RANDOM_STRING"  # must match backend WORKER_SHARED_SECRET
WORKER_HOST="127.0.0.1"   # set to 0.0.0.0 only if behind a reverse proxy that authenticates the caller
WORKER_PORT=8001

# Retry
MAX_RETRY_ATTEMPTS=3
