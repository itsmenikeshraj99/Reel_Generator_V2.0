# Supabase (DB + Storage)
# Use the SERVICE_ROLE key — the worker has its own auth (X-Worker-Secret) and needs full DB access
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"
STORAGE_BUCKET="reels-videos"

# Gemini AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Speech-to-text for the smart pipeline ("gemini" = current behaviour, "groq" needs a key)
ASR_PROVIDER="gemini"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_ASR_MODEL="whisper-large-v3-turbo"

# Short crossfades at topic/point changes in montages (smart pipeline); false = hard cuts
TRANSITIONS_ENABLED=false
TRANSITION_SECONDS=0.3

# On-screen hook title and point labels (smart pipeline); false = captions only
TEXT_OVERLAYS_ENABLED=false

# Background music. Each user chooses per video with the "Add background music" checkbox (off by default);
# this is only the kill switch. Needs migration 006 and tracks in worker/assets/music/<mood>/.
MUSIC_ENABLED=true
# Loudness of the finished reel (LUFS) and how far the music sits under the speech between words (dB)
LOUDNESS_TARGET_LUFS=-14
MUSIC_BELOW_SPEECH_DB=20

# Retries of the same Gemini model on a temporary error before using the next model (0-5)
GEMINI_TRANSIENT_RETRIES=2

# Picture placement on the 9:16 canvas: fit (whole frame centred on black, default) or crop (subject-aware crop)
REFRAME_MODE=fit

# Smart reel pipeline master switch (false = today's pipeline). When true, also set ASR_PROVIDER="groq".
SMART_PIPELINE_ENABLED=false

# Smart pipeline: target reel length in seconds (20-60)
REEL_TARGET_SECONDS=38
# Smart pipeline: how many times the verifier may send the plan back for revision (0-5)
MAX_REVISIONS=2

# Worker security
WORKER_SHARED_SECRET="GENERATE_A_LONG_RANDOM_STRING"  # must match backend WORKER_SHARED_SECRET
WORKER_HOST="127.0.0.1"   # set to 0.0.0.0 only if behind a reverse proxy that authenticates the caller
WORKER_PORT=8001

# Retry
MAX_RETRY_ATTEMPTS=3
