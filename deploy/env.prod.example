# Production env vars for Railway / Vercel deploys.
#
# This file is a TEMPLATE. Copy to a private location (NOT committed),
# fill in the real values, and paste them into the Railway / Vercel
# dashboard when prompted. The .example extension is a hint to git to
# ignore it.
#
#   cp deploy/env.prod.example deploy/env.prod
#   $EDITOR deploy/env.prod
#
# Then:
#   * Railway: Variables tab in each service. Set them per-service as
#     documented in SETUP.md.
#   * Vercel:  Project Settings → Environment Variables.
#
# DO NOT commit real values. Rotate the moment you suspect exposure.

# --- Supabase (from Settings -> API) ---
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="eyJ...service_role..."        # service_role key (server-only!)
SUPABASE_JWT_SECRET="super-secret-jwt-key"  # Settings -> API -> JWT Secret

# --- Gemini ---
GEMINI_API_KEY="AIza..."                    # https://aistudio.google.com/app/apikey
GEMINI_MODEL="gemini-2.5-flash"

# --- Storage ---
STORAGE_BUCKET="reels-videos"

# --- Worker handshake ---
# Generate fresh for prod (not the dev one). On macOS/Linux:
#   openssl rand -base64 48
# On Windows PowerShell:
#   [Convert]::ToBase64String((1..48|ForEach-Object{Get-Random -Maximum 256}))
# Must be IDENTICAL on the backend service and the worker service.
WORKER_SHARED_SECRET="CHANGE_ME_long_random_string"

# --- Worker port (Railway sets $PORT automatically; default 8080) ---
# The worker reads WORKER_HOST/WORKER_PORT from env. We override
# WORKER_HOST to 0.0.0.0 inside the Dockerfile so Railway can reach it.
WORKER_PORT=8080
