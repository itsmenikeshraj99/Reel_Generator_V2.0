# Production env vars for Cloud Run deploys.
# Source this file before running deploy-backend.sh / deploy-worker.sh:
#   set -a; source deploy/env.prod.example; set +a
#
# DO NOT commit this file with real values. The .example extension is
# a hint — copy to a private location, fill in, and source.

# --- GCP ---
export PROJECT_ID="reels-generator-XXXXXX"        # Your GCP project ID
export REGION="us-central1"                         # Pick one and stick with it

# --- Supabase (from Settings -> API) ---
export SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
export SUPABASE_KEY="eyJ...service_role..."        # service_role key (server-only!)
export SUPABASE_JWT_SECRET="super-secret-jwt-key"  # Settings -> API -> JWT Secret

# --- Gemini ---
export GEMINI_API_KEY="AIza..."                    # https://aistudio.google.com/app/apikey

# --- Worker handshake ---
# Generate fresh for prod (not the dev one):
#   openssl rand -base64 48
export WORKER_SHARED_SECRET="CHANGE_ME_long_random_string"

# --- Frontend (set after deploy) ---
# Initially a placeholder; update via `gcloud run services update` once
# you have a Vercel/Cloud Run URL for the frontend.
export FRONTEND_ORIGIN="https://reels-generator-xxx.vercel.app"

# --- Worker URL (set after worker deploy) ---
# Initially a placeholder; update via `gcloud run services update` once
# the worker is up. Must end with /process.
export WORKER_URL="https://reels-worker-xxx.a.run.app/process"
